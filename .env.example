# Ethereum mainnet JSON-RPC URL. Required for live Aave reads and monitoring.
AAVE_RPC_URL=

# Aave V3 Ethereum Pool. Override only when deliberately targeting a different Ethereum deployment.
AAVE_POOL_ADDRESS=0x87870bca3f3fd6335c3f4ce8392d69350b4fa4e2

# Aave Ethereum V3 account-data base currency uses 8 decimals.
AAVE_BASE_CURRENCY_DECIMALS=8

# Comma-separated public wallet addresses to monitor.
MONITORED_WALLETS=

# Minimum 60 seconds. v0.2 default is every 5 minutes.
MONITOR_INTERVAL_SECONDS=300

# Persistent local state; do not commit the generated file.
MONITOR_STATE_PATH=data/monitor-state.json

# Optional generic HTTP(S) webhook. When absent, monitoring runs but delivery is skipped.
ALERT_WEBHOOK_URL=

# Absolute Health Factor drop within the same risk state that triggers an alert.
ALERT_HF_DROP_THRESHOLD=0.1

PORT=3000
