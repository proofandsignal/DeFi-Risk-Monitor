# Ethereum mainnet JSON-RPC URL. Required for the live Aave account endpoint.
# Keep the full provider URL server-side only. Never expose it in docs/config.js.
AAVE_RPC_URL=

# Aave V3 Ethereum Pool. Override only when deliberately targeting a different Ethereum deployment.
AAVE_POOL_ADDRESS=0x87870bca3f3fd6335c3f4ce8392d69350b4fa4e2

# Aave Ethereum V3 account-data base currency uses 8 decimals.
AAVE_BASE_CURRENCY_DECIMALS=8

# Browser origin allowed to call the public scan and opt-in API.
CORS_ALLOWED_ORIGIN=https://proofandsignal.github.io

# Early-access abuse control for the live wallet scanner.
SCAN_RATE_LIMIT_PER_MINUTE=20

# Server-side Render Postgres connection URL for Founding Guard opt-ins.
# Keep secret. Never place this in docs/config.js or any client-side file.
DATABASE_URL=

PORT=3000
