# Ethereum mainnet JSON-RPC URL. Required for the live Aave account endpoint.
AAVE_RPC_URL=

# Aave V3 Ethereum Pool. Override only when deliberately targeting another market.
AAVE_POOL_ADDRESS=0x87870Bca3F3fd6335C3F4ce8392D69350B4fa4E2

# Aave Ethereum V3 account-data base currency uses 8 decimals.
AAVE_BASE_CURRENCY_DECIMALS=8

PORT=3000
